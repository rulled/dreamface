{
  "manifest_version": 3,
  "name": "DreamFace Batch Assistant",
  "version": "1.1.4",
  "description": "Batch-manage DreamFace audio uploads, local normalization, and Creations result downloads.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://dreamfaceapp.com/*",
    "https://www.dreamfaceapp.com/*",
    "https://tools.dreamfaceapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dreamfaceapp.com/*",
        "https://www.dreamfaceapp.com/*",
        "https://tools.dreamfaceapp.com/*"
      ],
      "js": ["content_script.js"]
    }
  ],
  "homepage_url": "https://github.com/rulled/dreamface",
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://dreamfaceapp.com/*",
        "https://www.dreamfaceapp.com/*",
        "https://tools.dreamfaceapp.com/*"
      ]
    }
  ]
}
