{
  "manifest_version": 3,
  "name": "dreamface",
  "version": "1.0.0",
  "description": "Batch audio automation for DreamFace video generation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://dreamfaceapp.com/*",
    "https://www.dreamfaceapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.dreamfaceapp.com/*"],
      "js": ["content_script.js"]
    }
  ],
  "homepage_url": "https://github.com/rulled/dreamface",
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
